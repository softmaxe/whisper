{
  "name": "whisper-demo",
  "private": true,
  "type": "module",
  "description": "Programmatic demo video for the Whisper README",
  "scripts": {
    "build": "node scripts/build.ts",
    "studio": "remotion studio",
    "timeline:export": "node scripts/export-timeline.ts",
    "music": "node scripts/render-music.ts",
    "render:en": "remotion render WhisperDemo-en out/whisper-demo-en.mp4",
    "render:zh": "remotion render WhisperDemo-zh out/whisper-demo-zh-CN.mp4",
    "render": "npm run render:en && npm run render:zh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:film": "vitest run --project film",
    "test:audio": "uv run --project audio pytest audio/tests -q",
    "test:all": "vitest run && npm run test:audio"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "^4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
