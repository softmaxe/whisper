{
  "name": "whisper",
  "version": "1.0.3",
  "description": "macOS dictation with self-hosted speech recognition and text cleanup",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:text-monitor": "node scripts/build-macos-text-monitor.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:native": "npm run compile:globe && npm run compile:fast-paste && npm run compile:text-monitor && npm run compile:media-remote && npm run compile:mediaremote-adapter && npm run compile:mic-listener",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run compile:native",
    "build": "npm run build:renderer && electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "npm run compile:native",
    "build:mac": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "prepack": "npm run compile:native",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "signing:create": "node scripts/create-signing-identity.js",
    "test:signing": "node scripts/test-macos-signing.js",
    "prepack:release": "npm run compile:native",
    "pack:release": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir -c.mac.sign=scripts/sign-macos-release.js -c.forceCodeSigning=true && node scripts/sign-macos-release.js --verify dist/mac-arm64/Whisper.app",
    "predist": "npm run compile:native",
    "dist": "npm run build:renderer && electron-builder --mac --arm64",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 REQUIRE_DB_TESTS=1 electron --import tsx --test \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run lint && npm run typecheck && npm run i18n:check && npm test",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "softmaxe",
    "url": "https://github.com/softmaxe"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "espree": "^11.2.0",
    "globals": "17.5.0",
    "opencc-js": "^1.4.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.4",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/groq": "^3.0.29",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/provider": "^3.0.14",
    "@better-auth/sso": "1.6.27",
    "@homebridge/dbus-native": "^0.7.7",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "ai": "^6.0.116",
    "better-auth": "1.6.27",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "tinfoil": "^1.1.8",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3",
    "ws": "8.21.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.2",
    "ip-address": "10.2.0",
    "markdown-it": "14.2.0",
    "tmp": "0.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softmaxe/whisper.git"
  },
  "homepage": "https://github.com/softmaxe/whisper",
  "bugs": {
    "url": "https://github.com/softmaxe/whisper/issues"
  }
}
