{
  "name": "whisper",
  "version": "1.1.7",
  "description": "macOS dictation with self-hosted speech recognition and text cleanup",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:text-monitor": "node scripts/build-macos-text-monitor.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:native": "pnpm run compile:globe && pnpm run compile:fast-paste && pnpm run compile:text-monitor && pnpm run compile:media-remote && pnpm run compile:mediaremote-adapter && pnpm run compile:mic-listener",
    "prestart": "pnpm run compile:native",
    "start": "electron .",
    "dev": "concurrently -k -r \"pnpm:dev:renderer\" \"pnpm:dev:main\"",
    "predev:main": "pnpm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "pnpm run compile:native",
    "build": "pnpm run build:renderer && electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "pnpm run compile:native",
    "build:mac": "pnpm run build:renderer && electron-builder --mac --arm64",
    "build:mac:arm64": "pnpm run build:renderer && electron-builder --mac --arm64",
    "prepack": "pnpm run compile:native",
    "pack": "pnpm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "signing:create": "node scripts/create-signing-identity.js",
    "test:signing": "node scripts/test-macos-signing.js",
    "prepack:release": "pnpm run compile:native",
    "pack:release": "pnpm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir -c.mac.sign=scripts/sign-macos-release.js -c.forceCodeSigning=true && node scripts/sign-macos-release.js --verify dist/mac-arm64/Whisper.app",
    "predist": "pnpm run compile:native",
    "dist": "pnpm run build:renderer && electron-builder --mac --arm64",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "pnpm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 REQUIRE_DB_TESTS=1 electron --import tsx --test \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "pnpm run lint && pnpm run typecheck && pnpm run i18n:check && pnpm test",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "softmaxe",
    "url": "https://github.com/softmaxe"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "17.5.0",
    "opencc-js": "^1.4.1",
    "prettier": "^3.8.3",
    "react-i18next": "^17.0.10",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.4",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softmaxe/whisper.git"
  },
  "homepage": "https://github.com/softmaxe/whisper",
  "bugs": {
    "url": "https://github.com/softmaxe/whisper/issues"
  }
}
